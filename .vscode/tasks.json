{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with Python Script",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}\\.vscode\\build_microbit.py",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        }
    ]
}